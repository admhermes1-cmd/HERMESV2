# ╔═════════════════════════════════════════════════════════════════╗
# ║                   MES — Variáveis de Ambiente                   ║
# ╚═════════════════════════════════════════════════════════════════╝
#
# Copie este arquivo para .env e preencha os valores do seu ambiente:
#   cp .env.example .env
#
# ⚠️  NUNCA commite o arquivo .env — ele está no .gitignore.
#     Este arquivo (.env.example) é seguro para versionar pois
#     contém apenas valores de exemplo, nunca secrets reais.
#
# Prefixo VITE_: apenas variáveis com este prefixo são expostas ao
# código do browser pelo Vite. Variáveis sem prefixo ficam restritas
# ao processo de build (vite.config.js) e nunca chegam ao cliente.
# ─────────────────────────────────────────────────────────────────────


# ─── API ──────────────────────────────────────────────────────────────────────

# URL base do backend HERMES (Spring Boot).
# Em desenvolvimento, o proxy do Vite (vite.config.js → server.proxy)
# intercepta chamadas `/api/*` e as repassa para este endereço —
# portanto o valor aqui só afeta o proxy, não o código do browser.
# Em produção, configure o valor real do servidor de backend.
VITE_API_BASE_URL=http://localhost:8080

# Timeout das requisições HTTP em milissegundos.
# Após esse tempo sem resposta, o apiClient cancela a requisição
# e lança um AppError com código TIMEOUT.
# Valor recomendado: 15000 (15 s) para ambientes de produção.
VITE_API_TIMEOUT=15000


# ─── Aplicação ────────────────────────────────────────────────────────────────

# Nome da aplicação exibido na interface (título da aba, header, etc.).
VITE_APP_NAME=HERMES

# Versão do frontend — mantenha sincronizada com a versão em package.json.
# Exibida no rodapé e enviada no header X-Client-Version das requisições.
VITE_APP_VERSION=1.0.0


# ─── Ferramentas de Desenvolvimento ───────────────────────────────────────────

# Habilitar mock de API para desenvolvimento sem backend disponível.
# Quando true, o apiClient intercepta todas as chamadas e retorna
# dados simulados definidos em src/mocks/ (MSW ou mocks internos).
# Valores aceitos: true | false
# ⚠️  Nunca defina como true em produção.
VITE_ENABLE_MOCK=false

# Nível de log exibido no console do browser.
# Valores aceitos: debug | info | warn | error
#   debug → todos os logs (requisições, respostas, estado interno)
#   info  → logs informativos + warnings + erros
#   warn  → somente warnings e erros
#   error → somente erros críticos
# Recomendado em desenvolvimento: debug
# Recomendado em produção:       error
VITE_LOG_LEVEL=info
